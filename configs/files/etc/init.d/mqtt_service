#!/bin/sh /etc/rc.common
START=95
STOP=05
USE_PROCD=1

stop_service() {
    procd_send_signal mqtt_service SIGTERM
    sleep 2
}

start_service() {
    procd_open_instance
    procd_set_param command /bin/sh -c "/usr/bin/python3 -u /usr/bin/mysh/mqtt.py >> /var/log/mqtt.log 2>&1"
    procd_set_param respawn
    procd_set_param respawn_delay 3
    procd_close_instance
}
